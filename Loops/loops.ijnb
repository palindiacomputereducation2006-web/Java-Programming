      "id": "1f8b50c4-1083-4cb7-8ab9-257c2b91dc16",
      "cell_type": "code",
      "source": "List<Integer> list = new ArrayList<Integer>(); \r\n\r\nint position = 7;\r\nint value = 100;\r\n\r\nfor (int i = 1; i <= 20; i++) {\r\n    list.add(i);\r\n}\r\nSystem.out.println(list);\r\n\r\nfor (int i = 1; i < list.size(); i++){\r\n    int index = list.indexOf(i);\r\n    if(index == position){\r\n        list.set(index,value);\r\n    }\r\n}\r\n\r\nSystem.out.println(list);",
      "metadata": {
