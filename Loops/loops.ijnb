            "text/plain": "these are the names : [John, Jane, Jack, Jill, James, Jenny, Joe, Jasmine, Jordan, Javier]\r\nthese are the names after the change : [John, Jane, Jack, Jill, James, Javed, Joe, Jasmine, Jordan, Javier]\r\n"
          },
          "metadata": {},
          "execution_count": 5
        }
      ]
