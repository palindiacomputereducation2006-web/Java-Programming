      "execution_count": 21,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Name: My name is John Wick and i worked in a movie called John Wick 4\r\nCharacter at index 4: a"
          },
          "metadata": {},
          "execution_count": 21
        }
      ]
