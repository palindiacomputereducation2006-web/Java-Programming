          },
          "metadata": {},
          "execution_count": 16
        }
      ]
    },
    {
      "id": "90e08f5f-0680-406a-8deb-5b6d02595afb",
      "cell_type": "code",
      "source": "String name = \"My name is John Wick and i worked in a movie called John Wick 4\";\r\nSystem.out.println(\"Name: \" + name);\r\n\r\n//this is to change every letter to a capital\r\n// Method: toUpperCase()\r\n// What:   returns a new string with all letters in upper case; digits and spaces do not change\r\n// Use:    for headings, or to compare text without caring about case\r\nString data = name.toUpperCase();\r\nSystem.out.println(\"Uppercase: \" + data);",
      "metadata": {
