    {
      "id": "2aae0db4-cdd4-4d29-9023-cbf4df4d77d9",
      "cell_type": "code",
      "source": "String name = \"My name is John Wick and i worked in a movie called John Wick 4\";\r\nSystem.out.println(\"Name: \" + name);\r\n\r\n//this is to read one character\r\n// Method: charAt(index)\r\n// What:   returns the single char at that position; indexes start at 0, so index 4 is the 5th character\r\n// Use:    to look at a letter, e.g. the first letter of a name\r\nchar data = name.charAt(4); // M=0 y=1 ' '=2 n=3 a=4\r\nSystem.out.print(\"Character at index 4: \" + data);",
      "metadata": {
        "language": "java",
        "id": "2aae0db4-cdd4-4d29-9023-cbf4df4d77d9",
        "executionSummary": {
          "executionOrder": 21,
          "success": true
        }
