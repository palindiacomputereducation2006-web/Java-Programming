    {
      "id": "300c9777-8b2c-4784-84f6-58f7f7edce07",
      "cell_type": "code",
      "source": "String name = \"My name is John Wick and i worked in a movie called John Wick 4\";\r\n\r\n//this is to check how the string ends\r\n// Method: endsWith(suffix)\r\n// What:   returns true when the string ends with exactly that suffix (case matters)\r\n// Use:    to check a file extension (\".jpg\") or the last word\r\nboolean is_end = name.endsWith(\"John Wick 4\"); // true, the sentence ends with \"John Wick 4\"\r\nSystem.out.print(\"ends with 'John Wick 4': \" + is_end);",
      "metadata": {
        "language": "java",
