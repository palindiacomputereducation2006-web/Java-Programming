    {
      "id": "b8014fcb-4655-4bc8-a1eb-7d8b143029f5",
      "cell_type": "code",
      "source": "String name = \"My name is John Wick and i worked in a movie called John Wick 4\";\r\nSystem.out.println(\"Name: \" + name);\r\n\r\n//this is to change every letter to a small letter\r\n// Method: toLowerCase()\r\n// What:   returns a new string with all letters in lower case\r\n// Use:    to normalise e-mail addresses or user names before saving them\r\nString data = name.toLowerCase();\r\nSystem.out.println(\"Lowercase: \" + data);",
