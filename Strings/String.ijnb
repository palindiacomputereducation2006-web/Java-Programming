    {
      "id": "9b839ab5-96a3-4279-8ba7-d9210e7b4adb",
      "cell_type": "code",
      "source": "String name = \"My name is John Wick\";\r\nString data = \"and i worked in a movie called John Wick 4\";\r\nSystem.out.println(\"Name: \" + name);\r\nSystem.out.println(\"Data: \" + data);\r\n\r\n//this is to join two strings\r\n// Method: concat(other)\r\n// What:   returns a new string with other glued to the end; the same as name + other\r\n// Use:    to build one text from parts (in everyday code the + operator is more common)\r\nString complete_Data = name.concat(\" \" + data); // \" \" adds the missing space between Wick and and\r\nSystem.out.print(\"Complete Data: \" + complete_Data);",
      "metadata": {
        "language": "java",
        "id": "9b839ab5-96a3-4279-8ba7-d9210e7b4adb",
        "executionSummary": {
          "executionOrder": 27,
          "success": true
        }
      },
      "execution_count": 27,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Name: My name is John Wick\r\nData: and i worked in a movie called John Wick 4\r\nComplete Data: My name is John Wick and i worked in a movie called John Wick 4"
          },
          "metadata": {},
          "execution_count": 27
        }
      ]
    },
    {
      "id": "b7b96341-7f5b-4546-bad0-efc45cd17424",
      "cell_type": "code",
      "source": "String data = \"My name is John Wick and i worked in a movie called John Wick 5\";\r\nString data2 = \"My name is John Wick and i worked in a movie called John Wick 4\";\r\n\r\n//this is to compare two strings alphabetically\r\n// Method: compareTo(other)\r\n// What:   returns 0 when both are equal, a negative number when this string comes first, a positive number when it comes after\r\n// Use:    to sort strings; the result is the difference of the first characters that differ\r\nint is_comapred = data.compareTo(data2); // '5' - '4' = 1, so data comes after data2\r\nSystem.out.print(\"Is compared: \" + is_comapred);",
      "metadata": {
        "language": "java",
        "id": "b7b96341-7f5b-4546-bad0-efc45cd17424",
        "executionSummary": {
          "executionOrder": 46,
          "success": true
        }
      },
      "execution_count": 46,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Is compared: 1"
          },
          "metadata": {},
          "execution_count": 46
        }
      ]
    },
    {
      "id": "4fe10327-96f0-4abb-99b0-1e248fe5269a",
      "cell_type": "code",
      "source": "String name = \"My name is John Wick and i worked in a movie called John Wick 4\";\r\n\r\n//this is to check how the string begins\r\n// Method: startsWith(prefix)\r\n// What:   returns true when the string begins with exactly that prefix (case matters)\r\n// Use:    to check a title, a URL scheme (https://) or a file name pattern\r\nboolean is_start = name.startsWith(\"My name\"); // true, the sentence begins with \"My name\"\r\nSystem.out.print(\"Starts with 'My name': \" + is_start);",
      "metadata": {
        "language": "java",
