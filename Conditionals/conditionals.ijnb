    {
      "id": "6eecdec2-48ea-4a86-a39b-92479df00468",
      "cell_type": "code",
      "source": "int a = 32;\r\n\r\n//Syntax\r\n// if(condition){\r\n\r\n// } else if (condition){\r\n//}\r\n\r\n//else{\r\n\r\n// }\r\n\r\n\r\nif(a > 32){\r\n    int number = 12;\r\n    int number1 = 32;\r\n\r\n    int sum = number + number1;\r\n    System.out.println(\"a is greater than b : \"+sum);\r\n}else if(a < 32){\r\n    int number = 12;\r\n    int number1 = 32;\r\n\r\n    int sum = number1 - number;\r\n    System.out.println(\"a is less than b : \"+sum);\r\n}else{\r\n    int number = 12;\r\n    int number1 = 32;\r\n\r\n    int sum = number1 * number;\r\n    System.out.println(\"a is equal to b : \"+sum);\r\n}",
      "metadata": {
        "language": "java",
        "executionSummary": {
          "executionOrder": 15,
          "success": true
        }
