    {
      "id": "430d33f1-b8f1-48cb-8c8a-e6608126acbc",
      "cell_type": "code",
      "source": "ArrayList<String> UsersNames = new ArrayList<>();\r\nUsersNames.addAll(Arrays.asList(\"Alice\", \"Bob\", \"Charlie\",\"David\", \"Eve\", \"Frank\", \"Grace\", \"Heidi\", \"Ivan\", \"Judy\"));\r\n\r\nSystem.out.println(\"Names in the list: \" + UsersNames);\r\n\r\npublic ArrayList<String> ChangeAndFilterName (ArrayList<String> names){\r\n    for (String name :names){\r\n        if(name.equals(\"Eve\")){\r\n            int index = names.indexOf(name);\r\n            names.set(index,\"Arbaz\");\r\n        }\r\n    }\r\n    return names;\r\n}\r\nArrayList<String> ChangedNames = ChangeAndFilterName(UsersNames);\r\nSystem.out.println(\"Changed Names in the list: \" + ChangedNames);",
      "metadata": {
        "language": "java",
        "executionSummary": {
          "executionOrder": 7,
          "success": true
        }
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Names in the list: [Alice, Bob, Charlie, David, Eve, Frank, Grace, Heidi, Ivan, Judy]\r\nChanged Names in the list: [Alice, Bob, Charlie, David, Arbaz, Frank, Grace, Heidi, Ivan, Judy]\r\n"
          },
          "metadata": {},
          "execution_count": 7
        }
      ]
    },
    {
      "id": "aa1a5383-f1b0-4e04-9438-8f316b8c4b25",
      "cell_type": "code",
      "source": "ArrayList<String> UsersNames = new ArrayList<>();\r\nUsersNames.addAll(Arrays.asList(\"Alice\", \"Bob\", \"Charlie\",\"David\", \"Eve\", \"Frank\", \"Grace\", \"Heidi\", \"Ivan\", \"Judy\"));\r\n\r\nSystem.out.println(\"Names in the list: \" + UsersNames);\r\n\r\nprivate int FindNamePosition (String name_for_position ,ArrayList<String> names){\r\n    int position = 0;\r\n    for (String name :names){\r\n        if(name.equals(name_for_position)){\r\n            int index = names.indexOf(name);\r\n            position = index;\r\n            break;\r\n        }else{\r\n            continue;\r\n        }\r\n    }\r\n    return position;\r\n}\r\nint data = FindNamePosition(\"Ivan\",UsersNames);\r\nSystem.out.println(\"Changed Names in the list: \" + data);",
      "metadata": {
        "language": "java",
        "executionSummary": {
          "executionOrder": 11,
          "success": true
        }
      },
      "execution_count": 11,
      "outputs": [
