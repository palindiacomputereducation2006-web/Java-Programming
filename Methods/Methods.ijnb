          "data": {
            "text/plain": "Names in the list: [Alice, Bob, Charlie, David, Eve, Frank, Grace, Heidi, Ivan, Judy]\r\nChanged Names in the list: 8\r\n"
          },
          "metadata": {},
          "execution_count": 11
        }
      ]
