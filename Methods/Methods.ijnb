    {
      "id": "c3df8e95-7f3e-4f19-8aee-681e73eaf287",
      "cell_type": "code",
      "source": "ArrayList<String> UsersNames = new ArrayList<>();\r\nUsersNames.addAll(Arrays.asList(\"Alice\", \"Bob\", \"Charlie\",\"David\", \"Eve\", \"Frank\", \"Grace\", \"Heidi\", \"Ivan\", \"Judy\"));\r\n\r\nSystem.out.println(\"Names in the list: \" + UsersNames);\r\n\r\nArrayList<String> ChangeAndFilterName (ArrayList<String> names){\r\n    for (String name :names){\r\n        if(name.equals(\"Eve\")){\r\n            int index = names.indexOf(name);\r\n            names.set(index,\"Soniya\");\r\n        }else{\r\n            continue;\r\n        }\r\n    }\r\n    return names;\r\n}\r\n\r\nArrayList<String> ChangedNames = ChangeAndFilterName(UsersNames);\r\nSystem.out.println(\"Changed Names in the list: \" + ChangedNames);",
