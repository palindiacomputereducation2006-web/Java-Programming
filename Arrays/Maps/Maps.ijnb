    {
      "id": "4621d903-b5ae-4b83-8c20-22e1b11fb6fc",
      "cell_type": "code",
      "source": "Map<String, Integer> marks = new LinkedHashMap<>();\r\nmarks.put(\"Zoya\", 85);\r\nmarks.put(\"Jane\", 92);\r\nmarks.put(\"Doe\", 78);\r\n\r\n//this is to get all keys\r\n// Method: keySet()\r\n// What:   returns a Set view of all keys\r\n// Use:    to loop over or check the keys\r\nSystem.out.println(\"Keys: \" + marks.keySet());\r\n\r\n//this is to get all values\r\n// Method: values()\r\n// What:   returns a Collection view of all values (can have duplicates)\r\n// Use:    to loop over the values, e.g. to sum them\r\nSystem.out.println(\"Values: \" + marks.values());\r\n\r\n//this is to get all pairs\r\n// Method: entrySet()\r\n// What:   returns a Set of Map.Entry objects; each entry has getKey() and getValue()\r\n// Use:    to loop over keys and values together\r\nSystem.out.println(\"Entries: \" + marks.entrySet());",
      "metadata": {
        "language": "java",
        "id": "4621d903-b5ae-4b83-8c20-22e1b11fb6fc",
        "executionSummary": {
          "executionOrder": 9,
          "success": true
        }
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Keys: [Zoya, Jane, Doe]\r\nValues: [85, 92, 78]\r\nEntries: [Zoya=85, Jane=92, Doe=78]\r\n"
          },
          "metadata": {},
          "execution_count": 9
        }
      ]
    },
    {
      "id": "1e6f4e94-6be3-4919-9aba-eec85d7c04ad",
      "cell_type": "code",
      "source": "Map<String, Integer> marks = new LinkedHashMap<>();\r\nmarks.put(\"Zoya\", 85);\r\nmarks.put(\"Jane\", 92);\r\nmarks.put(\"Doe\", 78);\r\n\r\n//this is to go through every pair with a for-each loop\r\n// Method: entrySet() + getKey() / getValue()\r\n// What:   gives you each Map.Entry; getKey() returns the key, getValue() returns the value\r\n// Use:    the usual way to read every key and value\r\nfor (Map.Entry<String, Integer> entry : marks.entrySet()) {\r\n    System.out.println(entry.getKey() + \" scored \" + entry.getValue());\r\n}\r\n\r\n//this is the shorter way with a lambda\r\n// Method: forEach((key, value) -> ...)\r\n// What:   runs the action once for every pair\r\n// Use:    a short way to read every pair\r\nmarks.forEach((name, score) -> System.out.println(name + \" -> \" + (score >= 80 ? \"Pass with distinction\" : \"Pass\")));",
      "metadata": {
        "language": "java",
        "id": "1e6f4e94-6be3-4919-9aba-eec85d7c04ad",
        "executionSummary": {
          "executionOrder": 10,
          "success": true
        }
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Zoya scored 85\r\nJane scored 92\r\nDoe scored 78\r\nZoya -> Pass with distinction\r\nJane -> Pass with distinction\r\nDoe -> Pass\r\n"
          },
          "metadata": {},
          "execution_count": 10
        }
      ]
    },
    {
      "id": "ec6a8bcc-d4ba-481f-9f01-c2b222829d33",
      "cell_type": "code",
      "source": "String sentence = \"the cat and the dog and the bird\";\r\nMap<String, Integer> wordCount = new TreeMap<>();\r\n\r\n//this is to count how many times each word appears\r\n// Method: merge(key, value, (oldValue, value) -> newValue)\r\n// What:   if the key is missing it puts the value; if it exists it combines old and new values with the rule\r\n// Use:    for counters and totals, here: add 1 for every word\r\nfor (String word : sentence.split(\" \")) {\r\n    wordCount.merge(word, 1, Integer::sum);\r\n}\r\nSystem.out.println(\"Word count: \" + wordCount);\r\n\r\n//the same counter with getOrDefault (older way)\r\nMap<String, Integer> count2 = new TreeMap<>();\r\nfor (String word : sentence.split(\" \")) {\r\n    // Method: getOrDefault(key, defaultValue)\r\n    // What:   returns the current count, or 0 the first time\r\n    // Use:    to add 1 without checking for null\r\n    count2.put(word, count2.getOrDefault(word, 0) + 1);\r\n}\r\nSystem.out.println(\"Same result: \" + count2.equals(wordCount));",
      "metadata": {
        "language": "java",
        "id": "ec6a8bcc-d4ba-481f-9f01-c2b222829d33",
        "executionSummary": {
          "executionOrder": 11,
          "success": true
        }
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Word count: {and=2, bird=1, cat=1, dog=1, the=3}\r\nSame result: true\r\n"
          },
          "metadata": {},
          "execution_count": 11
        }
      ]
    },
    {
      "id": "94469258-c077-4e80-98dc-3376a37d7dfe",
      "cell_type": "code",
      "source": "Map<String, Integer> stock = new HashMap<>(Map.of(\"Apple\", 10, \"Banana\", 5));\r\n\r\n//this is to calculate a new value from the key and the old value\r\n// Method: compute(key, (key, oldValue) -> newValue)\r\n// What:   sets the value to the result of the rule (oldValue is null if the key is missing)\r\n// Use:    to update a value based on its current value\r\nstock.compute(\"Apple\", (fruit, qty) -> qty == null ? 1 : qty + 1);\r\nSystem.out.println(\"After compute: \" + stock);\r\n\r\n// Method: computeIfPresent(key, (key, oldValue) -> newValue)\r\n// What:   runs the rule only if the key exists; returning null removes the key\r\n// Use:    to update only existing entries\r\nstock.computeIfPresent(\"Banana\", (fruit, qty) -> qty - 5 == 0 ? null : qty - 5);\r\nSystem.out.println(\"After computeIfPresent (Banana sold out): \" + stock);\r\n\r\n//this is to group values into lists\r\n// Method: computeIfAbsent(key, key -> newValue)\r\n// What:   if the key is missing, creates the value with the rule and puts it; then returns the value\r\n// Use:    to build a Map of lists without checking for null first\r\nMap<Character, List<String>> byLetter = new TreeMap<>();\r\nfor (String name : List.of(\"Zoya\", \"Jane\", \"Zara\", \"Doe\", \"John\")) {\r\n    byLetter.computeIfAbsent(name.charAt(0), letter -> new ArrayList<>()).add(name);\r\n}\r\nSystem.out.println(\"Grouped by first letter: \" + byLetter);",
      "metadata": {
        "language": "java",
        "id": "94469258-c077-4e80-98dc-3376a37d7dfe",
        "executionSummary": {
          "executionOrder": 12,
          "success": true
        }
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After compute: {Apple=11, Banana=5}\r\nAfter computeIfPresent (Banana sold out): {Apple=11}\r\nGrouped by first letter: {D=[Doe], J=[Jane, John], Z=[Zoya, Zara]}\r\n"
          },
          "metadata": {},
          "execution_count": 12
        }
      ]
    },
    {
      "id": "66ea5cb9-a66b-4f24-ac12-3843eedaf8c9",
      "cell_type": "code",
      "source": "//this is to create an IMMUTABLE map with Map.of()\r\n// Method: Map.of(k1, v1, k2, v2, ...)\r\n// What:   creates an IMMUTABLE map (up to 10 pairs); duplicate keys cause an error\r\n// Use:    for fixed data that must not change\r\nMap<String, Integer> days = Map.of(\"Mon\", 1, \"Tue\", 2);\r\nSystem.out.println(\"Map.of: \" + days);\r\n\r\n//days.put(\"Wed\", 3);   // not allowed: a Map.of() map cannot be changed (the program stops with an error)\r\n\r\n//this is to create an immutable map with more than 10 pairs\r\n// Method: Map.ofEntries(Map.entry(k, v), ...)\r\n// What:   creates an IMMUTABLE map from entries (no limit on how many)\r\n// Use:    for bigger fixed maps\r\nMap<String, Integer> codes = Map.ofEntries(\r\n    Map.entry(\"IN\", 91),\r\n    Map.entry(\"US\", 1)\r\n);\r\nSystem.out.println(\"Map.ofEntries: \" + codes);\r\n\r\n//this is to make an immutable copy of another map\r\n// Method: Map.copyOf(map)\r\n// What:   creates an IMMUTABLE copy; later changes to the original are not seen\r\n// Use:    to share a map without letting others change it\r\nMap<String, Integer> original = new HashMap<>(Map.of(\"A\", 1));\r\nMap<String, Integer> copy = Map.copyOf(original);\r\noriginal.put(\"B\", 2);\r\nSystem.out.println(\"Original: \" + original + \", Copy: \" + copy);",
      "metadata": {
        "language": "java",
        "id": "66ea5cb9-a66b-4f24-ac12-3843eedaf8c9",
        "executionSummary": {
          "executionOrder": 13,
          "success": true
        }
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Map.of: {Tue=2, Mon=1}\r\nMap.ofEntries: {US=1, IN=91}\r\nOriginal: {A=1, B=2}, Copy: {A=1}\r\n"
          },
          "metadata": {},
          "execution_count": 13
        }
      ]
