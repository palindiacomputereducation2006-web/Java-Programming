    {
      "id": "c2ed73ef-0ce0-4099-973d-e73a9483a892",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<Integer, String>();\r\n\r\n//this is to add key → value pairs\r\n// Method: put(key, value)\r\n// What:   adds the pair; if the key already exists it replaces the value and returns the OLD value (else null)\r\n// Use:    to add or update a value\r\nstudents.put(101, \"Zoya\");\r\nstudents.put(102, \"Jane\");\r\nstudents.put(103, \"Doe\");\r\nString old = students.put(102, \"Arbaz\"); // key 102 exists, so its value is replaced\r\n\r\nSystem.out.println(\"Old value of 102: \" + old);\r\nSystem.out.println(\"The map is: \" + students);",
      "metadata": {
        "language": "java",
        "id": "c2ed73ef-0ce0-4099-973d-e73a9483a892",
        "executionSummary": {
          "executionOrder": 2,
          "success": true
        }
      },
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Old value of 102: Jane\r\nThe map is: {101=Zoya, 102=Arbaz, 103=Doe}\r\n"
          },
          "metadata": {},
          "execution_count": 2
        }
      ]
    },
    {
      "id": "1fce67ca-ba6f-4771-bab9-872aa31796c5",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<>(Map.of(101, \"Zoya\", 102, \"Jane\"));\r\n\r\n//this is to read a value by its key\r\n// Method: get(key)\r\n// What:   returns the value for the key, or null if the key is not there\r\n// Use:    to look up one value\r\nSystem.out.println(\"get(101): \" + students.get(101));\r\nSystem.out.println(\"get(999): \" + students.get(999));\r\n\r\n// Method: getOrDefault(key, defaultValue)\r\n// What:   returns the value for the key, or the default value if the key is not there\r\n// Use:    to avoid null when a key may be missing\r\nSystem.out.println(\"getOrDefault(999): \" + students.getOrDefault(999, \"Unknown\"));",
      "metadata": {
        "language": "java",
        "id": "1fce67ca-ba6f-4771-bab9-872aa31796c5",
        "executionSummary": {
          "executionOrder": 3,
          "success": true
        }
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "get(101): Zoya\r\nget(999): null\r\ngetOrDefault(999): Unknown\r\n"
          },
          "metadata": {},
          "execution_count": 3
        }
      ]
    },
    {
      "id": "a92d69ab-bf05-4c92-81b8-1ddb3b847294",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<>(Map.of(101, \"Zoya\"));\r\n\r\n//this is to add a pair only if the key is not there yet\r\n// Method: putIfAbsent(key, value)\r\n// What:   adds the pair only when the key is missing; returns the existing value (or null if it was added)\r\n// Use:    to set a value without overwriting one that is already there\r\nstudents.putIfAbsent(101, \"Jane\"); // key exists, nothing changes\r\nstudents.putIfAbsent(102, \"Doe\");  // key missing, added\r\nSystem.out.println(\"After putIfAbsent: \" + students);\r\n\r\n//this is to copy all pairs of another map into this one\r\n// Method: putAll(otherMap)\r\n// What:   puts every pair of the other map; existing keys get the new value\r\n// Use:    to merge two maps\r\nstudents.putAll(Map.of(103, \"Arbaz\", 101, \"Zoya Khan\"));\r\nSystem.out.println(\"After putAll: \" + students);",
      "metadata": {
        "language": "java",
        "id": "a92d69ab-bf05-4c92-81b8-1ddb3b847294",
        "executionSummary": {
          "executionOrder": 4,
          "success": true
        }
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After putIfAbsent: {101=Zoya, 102=Doe}\r\nAfter putAll: {101=Zoya Khan, 102=Doe, 103=Arbaz}\r\n"
          },
          "metadata": {},
          "execution_count": 4
        }
      ]
    },
    {
      "id": "896d5fa5-d0f5-44ab-a73e-b17fa5591246",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<>(Map.of(101, \"Zoya\", 102, \"Jane\"));\r\n\r\n//this is to check if a key exists\r\n// Method: containsKey(key)\r\n// What:   returns true if the key is in the map (fast)\r\n// Use:    to check before get(), or to tell \"missing\" apart from a null value\r\nSystem.out.println(\"Has key 101? \" + students.containsKey(101));\r\nSystem.out.println(\"Has key 999? \" + students.containsKey(999));\r\n\r\n//this is to check if a value exists\r\n// Method: containsValue(value)\r\n// What:   returns true if any key has this value (slow: it checks every pair)\r\n// Use:    to search by value\r\nSystem.out.println(\"Has value Jane? \" + students.containsValue(\"Jane\"));\r\nSystem.out.println(\"Has value Doe? \" + students.containsValue(\"Doe\"));",
      "metadata": {
        "language": "java",
        "id": "896d5fa5-d0f5-44ab-a73e-b17fa5591246",
        "executionSummary": {
          "executionOrder": 5,
          "success": true
        }
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Has key 101? true\r\nHas key 999? false\r\nHas value Jane? true\r\nHas value Doe? false\r\n"
          },
          "metadata": {},
          "execution_count": 5
        }
      ]
    },
    {
      "id": "34855587-121b-433a-b7ff-43f2f657bcfb",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<>(Map.of(101, \"Zoya\", 102, \"Jane\", 103, \"Doe\"));\r\n\r\n//this is to remove a pair by its key\r\n// Method: remove(key)\r\n// What:   removes the pair and returns its value (null if the key was not there)\r\n// Use:    to delete one entry\r\nString removed = students.remove(101);\r\nSystem.out.println(\"Removed: \" + removed);\r\n\r\n// Method: remove(key, value)\r\n// What:   removes the pair only if the key has exactly this value; returns true/false\r\n// Use:    to delete safely when you are not sure of the current value\r\nSystem.out.println(\"remove(102, \\\"Doe\\\"): \" + students.remove(102, \"Doe\"));\r\nSystem.out.println(\"remove(102, \\\"Jane\\\"): \" + students.remove(102, \"Jane\"));\r\nSystem.out.println(\"The map is: \" + students);",
      "metadata": {
        "language": "java",
        "id": "34855587-121b-433a-b7ff-43f2f657bcfb",
        "executionSummary": {
          "executionOrder": 6,
          "success": true
        }
      },
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Removed: Zoya\r\nremove(102, \"Doe\"): false\r\nremove(102, \"Jane\"): true\r\nThe map is: {103=Doe}\r\n"
          },
          "metadata": {},
          "execution_count": 6
        }
      ]
    },
    {
      "id": "8a3633f3-6d4b-4028-9952-76490975072d",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<>(Map.of(101, \"Zoya\", 102, \"Jane\"));\r\n\r\n//this is to replace the value of a key that already exists\r\n// Method: replace(key, value)\r\n// What:   replaces the value only if the key exists (unlike put, it never adds a new key)\r\n// Use:    to update without creating new entries\r\nstudents.replace(101, \"Zoya Khan\");\r\nstudents.replace(999, \"Nobody\"); // key missing, nothing happens\r\nSystem.out.println(\"After replace: \" + students);\r\n\r\n// Method: replace(key, oldValue, newValue)\r\n// What:   replaces the value only if the key currently has oldValue; returns true/false\r\n// Use:    to update only when the value is what you expect\r\nSystem.out.println(\"Replaced? \" + students.replace(102, \"Jane\", \"Jane Doe\"));\r\nSystem.out.println(\"After replace(key, old, new): \" + students);\r\n\r\n//this is to change every value\r\n// Method: replaceAll((key, value) -> newValue)\r\n// What:   replaces each value with the result of the rule\r\n// Use:    to change all values at once, here: make them upper case\r\nstudents.replaceAll((id, name) -> name.toUpperCase());\r\nSystem.out.println(\"After replaceAll: \" + students);",
      "metadata": {
        "language": "java",
        "id": "8a3633f3-6d4b-4028-9952-76490975072d",
        "executionSummary": {
          "executionOrder": 7,
          "success": true
        }
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After replace: {101=Zoya Khan, 102=Jane}\r\nReplaced? true\r\nAfter replace(key, old, new): {101=Zoya Khan, 102=Jane Doe}\r\nAfter replaceAll: {101=ZOYA KHAN, 102=JANE DOE}\r\n"
          },
          "metadata": {},
          "execution_count": 7
        }
      ]
    },
    {
      "id": "ec207ab9-5bb3-4b91-8cd3-8a5071ab6e14",
      "cell_type": "code",
      "source": "Map<Integer, String> students = new HashMap<>(Map.of(101, \"Zoya\", 102, \"Jane\"));\r\n\r\n//this is to get the number of pairs\r\n// Method: size()\r\n// What:   returns how many key → value pairs are in the map\r\n// Use:    to know how many entries you have\r\nSystem.out.println(\"Size: \" + students.size());\r\n\r\n// Method: isEmpty()\r\n// What:   returns true if the map has no pairs\r\n// Use:    to check before working with the map\r\nSystem.out.println(\"Is empty? \" + students.isEmpty());",
