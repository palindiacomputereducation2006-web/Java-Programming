        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The list is: [Prachi, Krishita, Zoya, surbhi, humaira, Gayatri, pratik]\r\nIs Zoya in the list? : true\r\nIs arbaz in the list? : false\r\nAre Zoya and Krishita in the list? : true\r\nThe list is: [Prachi, Krishita, Zoya, surbhi, humaira, Gayatri, pratik]\r\n"
          },
          "metadata": {},
