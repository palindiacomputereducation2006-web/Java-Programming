    {
      "id": "8a62bbfe-9869-43df-a7af-e978b6eed252",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\"));\r\n\r\n//this is to add all items of another collection at the end\r\n// Method: addAll(collection) / addAll(index, collection)\r\n// What:   adds every item of another collection at the end, or at the given index\r\n// Use:    to add many values in one step instead of calling add() again and again\r\nfruits.addAll(Arrays.asList(\"Mango\", \"Orange\"));\r\nSystem.out.println(\"After addAll: \" + fruits);\r\n\r\n//this is to add all items of another collection at a given index\r\n// Method: List.of(items...)\r\n// What:   creates an IMMUTABLE list (cannot add, remove or set)\r\n// Use:    for fixed data that must not change\r\nfruits.addAll(1, List.of(\"Kiwi\", \"Papaya\"));\r\nSystem.out.println(\"After addAll(1, ...): \" + fruits);",
      "metadata": {
        "language": "java",
        "id": "8a62bbfe-9869-43df-a7af-e978b6eed252",
        "executionSummary": {
          "executionOrder": 29,
          "success": true
        }
      },
      "execution_count": 29,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After addAll: [Apple, Banana, Mango, Orange]\r\nAfter addAll(1, ...): [Apple, Kiwi, Papaya, Banana, Mango, Orange]\r\n"
          },
          "metadata": {},
          "execution_count": 29
        }
      ]
    },
    {
      "id": "5e1d5926-e284-4360-84e4-c882fec94e9c",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\", \"Orange\"));\r\n\r\n//this is to read an item by its index\r\n// Method: get(index)\r\n// What:   returns the item at the given index (index starts at 0)\r\n// Use:    to read one value from the list\r\nString first = fruits.get(0);\r\n// Method: size()\r\n// What:   returns how many items are in the list\r\n// Use:    to know the length, e.g. for the last index: size() - 1\r\nString last = fruits.get(fruits.size() - 1);\r\nSystem.out.println(\"The first fruit is: \" + first);\r\nSystem.out.println(\"The last fruit is: \" + last);",
      "metadata": {
        "language": "java",
        "id": "5e1d5926-e284-4360-84e4-c882fec94e9c",
        "executionSummary": {
          "executionOrder": 30,
          "success": true
        }
      },
      "execution_count": 30,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The first fruit is: Apple\r\nThe last fruit is: Orange\r\n"
          },
          "metadata": {},
          "execution_count": 30
        }
      ]
    },
    {
      "id": "90468915-6ea9-4b1a-88bf-483969c8554d",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\"));\r\n\r\n//this is to replace the item at an index; set() returns the old value\r\n// Method: set(index, item)\r\n// What:   replaces the item at the given index and returns the old value\r\n// Use:    to update a value that is already in the list\r\nString old = fruits.set(1, \"Cherry\");\r\nSystem.out.println(\"Replaced value: \" + old);\r\nSystem.out.println(\"The list is: \" + fruits);",
      "metadata": {
        "language": "java",
        "id": "90468915-6ea9-4b1a-88bf-483969c8554d",
        "executionSummary": {
          "executionOrder": 31,
          "success": true
        }
      },
      "execution_count": 31,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Replaced value: Banana\r\nThe list is: [Apple, Cherry, Mango]\r\n"
          },
          "metadata": {},
          "execution_count": 31
        }
      ]
    },
    {
      "id": "69e5510a-c4c3-40aa-984d-bcf6e5a5362d",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\", \"Orange\", \"Banana\"));\r\n\r\n//this is to remove by index; it returns the removed item\r\n// Method: remove(index) / remove(item)\r\n// What:   removes the item at an index (returns it), or the first matching item (returns true/false)\r\n// Use:    to take a value out of the list\r\nString removed = fruits.remove(0);\r\nSystem.out.println(\"Removed by index: \" + removed);\r\nSystem.out.println(\"The list is: \" + fruits);\r\n\r\n//this is to remove by value; it removes only the FIRST match and returns true/false\r\nboolean isRemoved = fruits.remove(\"Banana\");\r\nSystem.out.println(\"Was Banana removed? : \" + isRemoved);\r\nSystem.out.println(\"The list is: \" + fruits);",
      "metadata": {
        "language": "java",
        "id": "69e5510a-c4c3-40aa-984d-bcf6e5a5362d",
        "executionSummary": {
          "executionOrder": 32,
          "success": true
        }
      },
      "execution_count": 32,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Removed by index: Apple\r\nThe list is: [Banana, Mango, Orange, Banana]\r\nWas Banana removed? : true\r\nThe list is: [Mango, Orange, Banana]\r\n"
          },
          "metadata": {},
          "execution_count": 32
        }
      ]
    },
    {
      "id": "b79ccd74-7442-468f-93cc-480fc2eb7b68",
      "cell_type": "code",
      "source": "ArrayList<Integer> numbers = new ArrayList<>(List.of(10, 20, 30, 40));\r\n\r\n//careful with Integer lists: remove(1) removes INDEX 1, remove(Integer.valueOf(10)) removes the VALUE 10\r\n// Method: remove(index) / remove(item)\r\n// What:   removes the item at an index (returns it), or the first matching item (returns true/false)\r\n// Use:    to take a value out of the list\r\nnumbers.remove(1);\r\nSystem.out.println(\"After remove(1): \" + numbers);\r\n\r\n// Method: Integer.valueOf(number)\r\n// What:   turns an int into an Integer object\r\n// Use:    so remove() treats the number as a VALUE, not as an index\r\nnumbers.remove(Integer.valueOf(10));\r\nSystem.out.println(\"After remove(Integer.valueOf(10)): \" + numbers);",
      "metadata": {
        "language": "java",
        "id": "b79ccd74-7442-468f-93cc-480fc2eb7b68",
        "executionSummary": {
          "executionOrder": 33,
          "success": true
        }
      },
      "execution_count": 33,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After remove(1): [10, 30, 40]\r\nAfter remove(Integer.valueOf(10)): [30, 40]\r\n"
          },
          "metadata": {},
          "execution_count": 33
        }
      ]
    },
    {
      "id": "3aade68f-f87e-4414-be21-f654c9a71ed7",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\"));\r\n\r\n//this is to get the number of items and check if the list is empty\r\n// Method: size()\r\n// What:   returns how many items are in the list\r\n// Use:    to know the length, e.g. for the last index: size() - 1\r\nSystem.out.println(\"The size is: \" + fruits.size());\r\n// Method: isEmpty()\r\n// What:   returns true if the list has no items\r\n// Use:    to check before reading so you do not get an error\r\nSystem.out.println(\"Is the list empty? : \" + fruits.isEmpty());\r\n\r\nArrayList<String> emptyList = new ArrayList<>();\r\nSystem.out.println(\"Is emptyList empty? : \" + emptyList.isEmpty());",
      "metadata": {
        "language": "java",
        "id": "3aade68f-f87e-4414-be21-f654c9a71ed7",
        "executionSummary": {
          "executionOrder": 34,
          "success": true
        }
      },
      "execution_count": 34,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The size is: 3\r\nIs the list empty? : false\r\nIs emptyList empty? : true\r\n"
          },
