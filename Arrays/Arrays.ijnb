    {
      "id": "00ec9155-9afc-410b-b1fc-15d13b30ae82",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\"));\r\n\r\n//this is to make a copy of the list\r\nArrayList<String> copy = new ArrayList<>(fruits);\r\n// Method: equals(otherList)\r\n// What:   returns true if both lists have the same items in the same order\r\n// Use:    to compare two lists (== only checks if they are the same object)\r\nSystem.out.println(\"Are both lists equal? : \" + fruits.equals(copy));\r\n\r\n//changing the copy does not change the original\r\n// Method: add(item) / add(index, item)\r\n// What:   adds an item at the end, or inserts it at the given index (items after it shift right)\r\n// Use:    to put new values into the list\r\ncopy.add(\"Mango\");\r\nSystem.out.println(\"Original: \" + fruits);\r\nSystem.out.println(\"Copy: \" + copy);\r\nSystem.out.println(\"Are both lists equal now? : \" + fruits.equals(copy));",
      "metadata": {
        "language": "java",
        "id": "00ec9155-9afc-410b-b1fc-15d13b30ae82",
        "executionSummary": {
          "executionOrder": 45,
          "success": true
        }
      },
      "execution_count": 45,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Are both lists equal? : true\r\nOriginal: [Apple, Banana]\r\nCopy: [Apple, Banana, Mango]\r\nAre both lists equal now? : false\r\n"
          },
          "metadata": {},
          "execution_count": 45
        }
      ]
    },
    {
      "id": "2f7ae232-b455-4ce0-a394-521a4a8dbfc2",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>();\r\n\r\n//this is to make sure the list has room for 100 items (avoids resizing many times)\r\n// Method: ensureCapacity(n)\r\n// What:   makes sure there is room for at least n items\r\n// Use:    to avoid many slow resizes when you know many items are coming\r\nfruits.ensureCapacity(100);\r\n// Method: add(item) / add(index, item)\r\n// What:   adds an item at the end, or inserts it at the given index (items after it shift right)\r\n// Use:    to put new values into the list\r\nfruits.add(\"Apple\");\r\nfruits.add(\"Banana\");\r\n\r\n//this is to shrink the capacity down to the current size to save memory\r\n// Method: trimToSize()\r\n// What:   shrinks the capacity down to the current size\r\n// Use:    to free unused memory after you finish adding\r\nfruits.trimToSize();\r\n// Method: size()\r\n// What:   returns how many items are in the list\r\n// Use:    to know the length, e.g. for the last index: size() - 1\r\nSystem.out.println(\"The list is: \" + fruits + \" , size: \" + fruits.size());",
      "metadata": {
        "language": "java",
        "id": "2f7ae232-b455-4ce0-a394-521a4a8dbfc2",
        "executionSummary": {
          "executionOrder": 46,
          "success": true
        }
      },
      "execution_count": 46,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The list is: [Apple, Banana] , size: 2\r\n"
          },
          "metadata": {},
          "execution_count": 46
        }
      ]
    },
    {
      "id": "ea571d61-44de-44ea-8a47-27349abd1930",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\"));\r\nSystem.out.println(\"Before clear: \" + fruits);\r\n\r\n//this is to remove every item from the list\r\n// Method: clear()\r\n// What:   removes every item; the list becomes empty but can still be used\r\n// Use:    to reset the list and start again\r\nfruits.clear();\r\nSystem.out.println(\"After clear: \" + fruits);\r\n// Method: isEmpty()\r\n// What:   returns true if the list has no items\r\n// Use:    to check before reading so you do not get an error\r\nSystem.out.println(\"Is the list empty? : \" + fruits.isEmpty());",
      "metadata": {
        "language": "java",
        "id": "ea571d61-44de-44ea-8a47-27349abd1930",
        "executionSummary": {
          "executionOrder": 47,
          "success": true
