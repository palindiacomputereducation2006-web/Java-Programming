    {
      "id": "595960b2-63bf-4b38-939a-be00c33e5cb5",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\"));\r\n\r\n//this is to check if one item is in the list\r\n// Method: contains(item)\r\n// What:   returns true if the item is in the list\r\n// Use:    to check if a value exists before using it\r\nSystem.out.println(\"Is Mango in the list? : \" + fruits.contains(\"Mango\"));\r\nSystem.out.println(\"Is Kiwi in the list? : \" + fruits.contains(\"Kiwi\"));\r\n\r\n//this is to check if ALL items are in the list\r\n// Method: containsAll(collection)\r\n// What:   returns true only if EVERY item of the other collection is in the list\r\n// Use:    to check many values at once\r\nSystem.out.println(\"Are Apple and Banana in the list? : \" + fruits.containsAll(List.of(\"Apple\", \"Banana\")));",
      "metadata": {
        "language": "java",
        "id": "595960b2-63bf-4b38-939a-be00c33e5cb5",
        "executionSummary": {
          "executionOrder": 35,
          "success": true
        }
      },
      "execution_count": 35,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Is Mango in the list? : true\r\nIs Kiwi in the list? : false\r\nAre Apple and Banana in the list? : true\r\n"
          },
          "metadata": {},
          "execution_count": 35
        }
      ]
    },
    {
      "id": "69dc8a88-149a-4e94-9bbc-07f96e61fa4d",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\", \"Banana\"));\r\n\r\n//this is to find the first and the last index of an item (-1 means not found)\r\n// Method: indexOf(item) / indexOf(item, fromIndex)\r\n// What:   returns the index of the first match, or -1 if not found\r\n// Use:    to find where a value is in the list\r\nSystem.out.println(\"First index of Banana: \" + fruits.indexOf(\"Banana\"));\r\n// Method: lastIndexOf(item)\r\n// What:   returns the index of the last match, or -1 if not found\r\n// Use:    to find the last position of a value that appears more than once\r\nSystem.out.println(\"Last index of Banana: \" + fruits.lastIndexOf(\"Banana\"));\r\nSystem.out.println(\"Index of Kiwi: \" + fruits.indexOf(\"Kiwi\"));",
      "metadata": {
        "language": "java",
        "id": "69dc8a88-149a-4e94-9bbc-07f96e61fa4d",
        "executionSummary": {
          "executionOrder": 36,
          "success": true
        }
      },
      "execution_count": 36,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "First index of Banana: 1\r\nLast index of Banana: 3\r\nIndex of Kiwi: -1\r\n"
          },
          "metadata": {},
          "execution_count": 36
        }
      ]
    },
    {
      "id": "880d2431-5e0e-433a-a2df-1c8d391b2626",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Apple\", \"Banana\", \"Mango\", \"Orange\", \"Kiwi\"));\r\n\r\n//this is to remove every item that is also in another collection\r\n// Method: removeAll(collection)\r\n// What:   removes every item that is also in the other collection\r\n// Use:    to delete many values in one step\r\nfruits.removeAll(List.of(\"Banana\", \"Kiwi\"));\r\nSystem.out.println(\"After removeAll: \" + fruits);\r\n\r\n//this is to keep ONLY the items that are also in another collection\r\n// Method: retainAll(collection)\r\n// What:   keeps ONLY the items that are also in the other collection; removes the rest\r\n// Use:    to find the common values between two lists\r\nfruits.retainAll(List.of(\"Apple\", \"Orange\", \"Grapes\"));\r\nSystem.out.println(\"After retainAll: \" + fruits);",
      "metadata": {
        "language": "java",
        "id": "880d2431-5e0e-433a-a2df-1c8d391b2626",
        "executionSummary": {
          "executionOrder": 37,
          "success": true
        }
      },
      "execution_count": 37,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After removeAll: [Apple, Mango, Orange]\r\nAfter retainAll: [Apple, Orange]\r\n"
          },
          "metadata": {},
          "execution_count": 37
        }
      ]
    },
    {
      "id": "57ca6656-a818-44ec-8718-91f2ce24e47d",
      "cell_type": "code",
      "source": "ArrayList<Integer> numbers = new ArrayList<>(List.of(5, 12, 7, 20, 3, 18));\r\n\r\n//this is to remove every item that matches a condition\r\n// Method: removeIf(condition)\r\n// What:   removes every item for which the condition (a lambda) is true\r\n// Use:    to delete values by a rule, e.g. all numbers below 10\r\nnumbers.removeIf(n -> n < 10);\r\nSystem.out.println(\"Numbers 10 and above: \" + numbers);",
