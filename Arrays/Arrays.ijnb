    {
      "id": "9b4021ba-f61e-40eb-8e50-0049bb78776b",
      "cell_type": "code",
      "source": "ArrayList<String> fruits = new ArrayList<>(List.of(\"Mango\", \"Apple\", \"Orange\", \"Banana\"));\r\n\r\n//this is to sort in ascending (A to Z) order\r\n// Method: sort(null)\r\n// What:   sorts the list itself; null means natural order (A to Z, small to big)\r\n// Use:    to put the items in order\r\nfruits.sort(null);\r\nSystem.out.println(\"Ascending: \" + fruits);",
      "metadata": {
