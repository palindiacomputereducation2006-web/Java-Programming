      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "City at index 1: Delhi\r\nAfter set: [Mumbai, Kolkata, Pune]\r\n"
          },
          "metadata": {},
          "execution_count": 53
        }
