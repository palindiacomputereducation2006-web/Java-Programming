    {
      "id": "06c9e17a-7cf9-4509-a91a-7bf60b2b3cb1",
      "cell_type": "code",
      "source": "ArrayList<String> namesList = new ArrayList<String>();\r\n\r\n// Method: add(item) / add(index, item)\r\n// What:   adds an item at the end, or inserts it at the given index (items after it shift right)\r\n// Use:    to put new values into the list\r\nnamesList.add(\"Prachi\");\r\nnamesList.add(\"Krishita\");\r\nnamesList.add(\"Zoya\");\r\n\r\n// Method: addAll(collection) / addAll(index, collection)\r\n// What:   adds every item of another collection at the end, or at the given index\r\n// Use:    to add many values in one step instead of calling add() again and again\r\nnamesList.addAll(Arrays.asList(\"surbhi\",\"humaira\",\"Gayatri\",\"pratik\"));\r\n// Method: set(index, item)\r\n// What:   replaces the item at the given index and returns the old value\r\n// Use:    to update a value that is already in the list\r\nnamesList.set(0, \"Arbaz\");\r\nnamesList.add(0,\"Zoya\");\r\nSystem.out.println(\"The list is: \" + namesList);\r\n",
      "metadata": {
        "language": "java",
        "id": "06c9e17a-7cf9-4509-a91a-7bf60b2b3cb1",
        "executionSummary": {
          "executionOrder": 18,
          "success": true
        }
      },
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The list is: [Zoya, Arbaz, Krishita, Zoya, surbhi, humaira, Gayatri, pratik]\r\n"
          },
          "metadata": {},
          "execution_count": 18
        }
      ]
