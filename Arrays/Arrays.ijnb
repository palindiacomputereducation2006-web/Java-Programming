    },
    {
      "id": "5cced051-c106-485f-b0b4-ebbf819c426e",
      "cell_type": "code",
      "source": "List<String> cities = new ArrayList<>(List.of(\"Mumbai\", \"Delhi\", \"Pune\"));\r\n\r\n//this is to add at an index and remove by index / by value\r\n// Method: add(item) / add(index, item)\r\n// What:   adds an item at the end, or inserts it at the given index (items after it shift right)\r\n// Use:    to put new values into the list\r\ncities.add(0, \"Jaipur\");\r\nSystem.out.println(\"After add(0, ...): \" + cities);\r\n\r\n// Method: remove(index) / remove(item)\r\n// What:   removes the item at an index (returns it), or the first matching item (returns true/false)\r\n// Use:    to take a value out of the list\r\ncities.remove(2);\r\nSystem.out.println(\"After remove(2): \" + cities);\r\n\r\ncities.remove(\"Pune\");\r\nSystem.out.println(\"After remove(\\\"Pune\\\"): \" + cities);",
      "metadata": {
        "language": "java",
        "id": "5cced051-c106-485f-b0b4-ebbf819c426e",
        "executionSummary": {
          "executionOrder": 54,
          "success": true
        }
      },
      "execution_count": 54,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After add(0, ...): [Jaipur, Mumbai, Delhi, Pune]\r\nAfter remove(2): [Jaipur, Mumbai, Pune]\r\nAfter remove(\"Pune\"): [Jaipur, Mumbai]\r\n"
          },
          "metadata": {},
          "execution_count": 54
        }
      ]
    },
    {
      "id": "3b328e59-6ef2-4515-bb9f-eff98ef10677",
      "cell_type": "code",
      "source": "List<String> cities = new ArrayList<>(List.of(\"Mumbai\", \"Delhi\", \"Pune\", \"Delhi\"));\r\n\r\n//this is to check size, empty, contains and index\r\n// Method: size()\r\n// What:   returns how many items are in the list\r\n// Use:    to know the length, e.g. for the last index: size() - 1\r\nSystem.out.println(\"Size: \" + cities.size());\r\n// Method: isEmpty()\r\n// What:   returns true if the list has no items\r\n// Use:    to check before reading so you do not get an error\r\nSystem.out.println(\"Is empty? : \" + cities.isEmpty());\r\n// Method: contains(item)\r\n// What:   returns true if the item is in the list\r\n// Use:    to check if a value exists before using it\r\nSystem.out.println(\"Contains Pune? : \" + cities.contains(\"Pune\"));\r\n// Method: indexOf(item) / indexOf(item, fromIndex)\r\n// What:   returns the index of the first match, or -1 if not found\r\n// Use:    to find where a value is in the list\r\nSystem.out.println(\"First index of Delhi: \" + cities.indexOf(\"Delhi\"));\r\n// Method: lastIndexOf(item)\r\n// What:   returns the index of the last match, or -1 if not found\r\n// Use:    to find the last position of a value that appears more than once\r\nSystem.out.println(\"Last index of Delhi: \" + cities.lastIndexOf(\"Delhi\"));",
      "metadata": {
        "language": "java",
        "id": "3b328e59-6ef2-4515-bb9f-eff98ef10677",
        "executionSummary": {
          "executionOrder": 55,
          "success": true
        }
      },
      "execution_count": 55,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Size: 4\r\nIs empty? : false\r\nContains Pune? : true\r\nFirst index of Delhi: 1\r\nLast index of Delhi: 3\r\n"
          },
          "metadata": {},
          "execution_count": 55
        }
      ]
    },
    {
      "id": "3067f1f5-9b38-4246-9baf-ea426eca86f3",
      "cell_type": "code",
      "source": "List<String> cities = new ArrayList<>(List.of(\"Pune\", \"Mumbai\", \"Goa\", \"Delhi\"));\r\n\r\n//this is to sort A to Z (null means natural order)\r\n// Method: sort(null)\r\n// What:   sorts the list itself; null means natural order (A to Z, small to big)\r\n// Use:    to put the items in order\r\ncities.sort(null);\r\nSystem.out.println(\"A to Z: \" + cities);",
      "metadata": {
        "language": "java",
        "id": "3067f1f5-9b38-4246-9baf-ea426eca86f3",
        "executionSummary": {
          "executionOrder": 56,
