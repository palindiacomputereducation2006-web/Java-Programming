    {
      "id": "8cf2c94b-5b44-49e7-8743-19f0eca8b0c7",
      "cell_type": "code",
      "source": "    //Syntax\r\n\r\n    //DataTypeList<DataType> variable_name = new DataTypeList<DataType>();\r\n\r\n    ArrayList<String> namesList = new ArrayList<String>();\r\n    namesList.add(\"Prachi\");\r\n    namesList.add(\"Krishita\");\r\n    namesList.add(\"Zoya\");\r\n\r\n    namesList.addAll(Arrays.asList(\"surbhi\",\"humaira\",\"Gayatri\",\"pratik\"));\r\n\r\n    System.out.println(\"The list is: \" + namesList); // Output: The list is: [Prachi, Krishita, Zoya, surbhi, humaira, Gayatri, pratik]\r\n\r\n    //this is to verify contains method\r\n    boolean is_exist = namesList.contains(\"Zoya\");\r\n    System.out.println(\"Is Zoya in the list? : \" + is_exist);\r\n\r\n    //this is to verify contains method \r\n    boolean is_exist = namesList.contains(\"arbaz\");\r\n    System.out.println(\"Is arbaz in the list? : \" + is_exist);\r\n\r\n    // this is to verify contains all method     \r\n    boolean is_exist = namesList.containsAll(Arrays.asList(\"Zoya\", \"Krishita\"));\r\n    System.out.println(\"Are Zoya and Krishita in the list? : \" + is_exist);",
      "metadata": {
        "language": "java",
        "id": "8cf2c94b-5b44-49e7-8743-19f0eca8b0c7",
        "executionSummary": {
          "executionOrder": 11,
          "success": true
        }
      },
      "execution_count": 11,
