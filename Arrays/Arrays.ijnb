        }
      },
      "execution_count": 56,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "A to Z: [Delhi, Goa, Mumbai, Pune]\r\n"
          },
          "metadata": {},
          "execution_count": 56
        }
      ]
    },
    {
      "id": "7ae83510-2927-4c59-9f0c-4c33df819de7",
      "cell_type": "code",
      "source": "List<String> cities = new ArrayList<>(List.of(\"mumbai\", \"delhi\", \"pune\"));\r\n\r\n//this is to change every item\r\n// Method: replaceAll(rule)\r\n// What:   changes every item using the rule (a lambda) you give it\r\n// Use:    to update all values at once, e.g. make every name UPPERCASE\r\ncities.replaceAll(String::toUpperCase);\r\nSystem.out.println(\"After replaceAll: \" + cities);\r\n\r\n//this is to remove items that match a condition\r\n// Method: removeIf(condition)\r\n// What:   removes every item for which the condition (a lambda) is true\r\n// Use:    to delete values by a rule, e.g. all numbers below 10\r\ncities.removeIf(city -> city.startsWith(\"D\"));\r\nSystem.out.println(\"After removeIf: \" + cities);",
      "metadata": {
        "language": "java",
        "id": "7ae83510-2927-4c59-9f0c-4c33df819de7",
        "executionSummary": {
          "executionOrder": 57,
          "success": true
        }
      },
      "execution_count": 57,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "After replaceAll: [MUMBAI, DELHI, PUNE]\r\nAfter removeIf: [MUMBAI, PUNE]\r\n"
          },
          "metadata": {},
          "execution_count": 57
        }
      ]
    },
    {
      "id": "13c910ef-59e1-4c02-83f4-d29ffd22d928",
      "cell_type": "code",
      "source": "List<String> cities = new ArrayList<>(List.of(\"Mumbai\", \"Delhi\", \"Pune\", \"Goa\", \"Jaipur\"));\r\n\r\n//this is to get a part of the list (start included, end excluded)\r\n// Method: subList(fromIndex, toIndex)\r\n// What:   returns the part of the list from fromIndex (included) to toIndex (excluded)\r\n// Use:    to work with only a section of the list\r\nList<String> part = cities.subList(1, 3);\r\nSystem.out.println(\"The sub list is: \" + part);",
      "metadata": {
        "language": "java",
        "id": "13c910ef-59e1-4c02-83f4-d29ffd22d928",
        "executionSummary": {
          "executionOrder": 58,
          "success": true
        }
      },
      "execution_count": 58,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The sub list is: [Delhi, Pune]\r\n"
          },
          "metadata": {},
          "execution_count": 58
        }
      ]
    },
    {
      "id": "630d76af-4161-41d6-95b3-cb84497d48ab",
      "cell_type": "code",
      "source": "List<String> cities = new ArrayList<>(List.of(\"Mumbai\", \"Delhi\", \"Pune\"));\r\n\r\n//Java 21+: methods to work with the first and the last item\r\n// Method: getFirst()  [Java 21+]\r\n// What:   returns the first item of the list\r\n// Use:    to read the first value without writing get(0)\r\nSystem.out.println(\"First: \" + cities.getFirst());\r\n// Method: getLast()  [Java 21+]\r\n// What:   returns the last item of the list\r\n// Use:    to read the last value without writing get(size() - 1)\r\nSystem.out.println(\"Last: \" + cities.getLast());\r\n\r\n// Method: addFirst(item)  [Java 21+]\r\n// What:   inserts an item at the very start of the list\r\n// Use:    to put a value in front without writing add(0, item)\r\ncities.addFirst(\"Goa\");\r\n// Method: addLast(item)  [Java 21+]\r\n// What:   adds an item at the very end of the list\r\n// Use:    to make \"add at the end\" clear and readable\r\ncities.addLast(\"Jaipur\");\r\nSystem.out.println(\"After addFirst/addLast: \" + cities);\r\n\r\n// Method: removeFirst()  [Java 21+]\r\n// What:   removes and returns the first item\r\n// Use:    to take values from the front, like a queue\r\ncities.removeFirst();\r\n// Method: removeLast()  [Java 21+]\r\n// What:   removes and returns the last item\r\n// Use:    to take values from the end\r\ncities.removeLast();\r\nSystem.out.println(\"After removeFirst/removeLast: \" + cities);\r\n\r\n//Java 21+: a reversed view of the list\r\n// Method: reversed()  [Java 21+]\r\n// What:   returns a reversed VIEW of the list (the original is not changed)\r\n// Use:    to read the list backwards without making a copy\r\nSystem.out.println(\"Reversed: \" + cities.reversed());",
      "metadata": {
        "language": "java",
        "id": "630d76af-4161-41d6-95b3-cb84497d48ab",
        "executionSummary": {
          "executionOrder": 60,
          "success": true
        }
      },
      "execution_count": 60,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "First: Mumbai\r\nLast: Pune\r\nAfter addFirst/addLast: [Goa, Mumbai, Delhi, Pune, Jaipur]\r\nAfter removeFirst/removeLast: [Mumbai, Delhi, Pune]\r\nReversed: [Pune, Delhi, Mumbai]\r\n"
          },
          "metadata": {},
          "execution_count": 60
        }
      ]
    },
    {
      "id": "c8bb23ba-c771-402f-871c-664fd672e3e6",
      "cell_type": "code",
      "source": "List<String> a = new ArrayList<>(List.of(\"Mumbai\", \"Delhi\"));\r\nList<String> b = new ArrayList<>(List.of(\"Mumbai\", \"Delhi\"));\r\n\r\n//two lists are equal when they have the same items in the same order\r\n// Method: equals(otherList)\r\n// What:   returns true if both lists have the same items in the same order\r\n// Use:    to compare two lists (== only checks if they are the same object)\r\nSystem.out.println(\"Are a and b equal? : \" + a.equals(b));\r\n\r\n//this is to convert the List into an array\r\n// Method: toArray(new Type[0])\r\n// What:   copies the items into a normal array\r\n// Use:    when a method needs an array instead of a list\r\nString[] arr = a.toArray(new String[0]);\r\n// Method: Arrays.toString(array)\r\n// What:   turns an array into readable text like [a, b, c]\r\n// Use:    to print an array (println(array) prints only a memory address)\r\nSystem.out.println(\"Array: \" + Arrays.toString(arr));",
      "metadata": {
        "language": "java",
        "id": "c8bb23ba-c771-402f-871c-664fd672e3e6",
        "executionSummary": {
          "executionOrder": 63,
          "success": true
        }
      },
      "execution_count": 63,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "Are a and b equal? : true\r\nArray: [Mumbai, Delhi]\r\n"
          },
          "metadata": {},
          "execution_count": 63
        }
      ]
    },
    {
      "id": "23460571-68d8-4847-a04c-7e4fccc1f96f",
      "cell_type": "markdown",
      "source": "# Vector – properties and methods\r\n\r\n`Vector` is an older (Java 1.0) resizable array in `java.util`. It works like `ArrayList` and implements `List`, with a few differences.\r\n\r\n**Properties**\r\n- **Synchronized**: every method is thread-safe, so it is slower than `ArrayList` in single-threaded code.\r\n- Default capacity is **10**; when full it **doubles** (×2), unless you set a `capacityIncrement`.\r\n- Ordered, index-based, allows duplicates and `null`.\r\n- Has extra **legacy methods** such as `addElement`, `elementAt`, `firstElement`, `removeElement`.\r\n- In new code, prefer `ArrayList`. You will still see `Vector` in older code.",
      "metadata": {
        "language": "markdown",
        "id": "23460571-68d8-4847-a04c-7e4fccc1f96f"
      }
    },
    {
      "id": "d96f48dc-e264-4723-8673-971ae882e778",
      "cell_type": "code",
      "source": "//Syntax\r\n//Vector<DataType> variable_name = new Vector<DataType>();\r\n\r\n//this is to create an empty Vector and check its size and capacity\r\nVector<String> colors = new Vector<String>();\r\nSystem.out.println(\"The vector is: \" + colors);\r\n// Method: size()\r\n// What:   returns how many items are in the list\r\n// Use:    to know the length, e.g. for the last index: size() - 1\r\n// Method: capacity()  [Vector only]\r\n// What:   returns how many items fit before the Vector has to grow (not the same as size())\r\n// Use:    to see how the internal storage grows\r\nSystem.out.println(\"Size: \" + colors.size() + \" , Capacity: \" + colors.capacity());",
      "metadata": {
        "language": "java",
        "id": "d96f48dc-e264-4723-8673-971ae882e778",
        "executionSummary": {
          "executionOrder": 64,
          "success": true
        }
      },
      "execution_count": 64,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The vector is: []\r\nSize: 0 , Capacity: 10\r\n"
          },
          "metadata": {},
          "execution_count": 64
        }
      ]
    },
    {
      "id": "7ff94d30-fb7d-4d59-aee2-e19b31417535",
      "cell_type": "code",
      "source": "Vector<String> colors = new Vector<String>();\r\n\r\n//this is to add items: add() and the legacy addElement() do the same thing\r\n// Method: add(item) / add(index, item)\r\n// What:   adds an item at the end, or inserts it at the given index (items after it shift right)\r\n// Use:    to put new values into the list\r\ncolors.add(\"Red\");\r\ncolors.add(\"Green\");\r\n// Method: addElement(item)  [Vector only, legacy]\r\n// What:   adds an item at the end (same as add())\r\n// Use:    in old Vector code; new code uses add()\r\ncolors.addElement(\"Blue\");\r\ncolors.addElement(\"Yellow\");\r\n\r\nSystem.out.println(\"The vector is: \" + colors);",
      "metadata": {
        "language": "java",
        "id": "7ff94d30-fb7d-4d59-aee2-e19b31417535",
        "executionSummary": {
          "executionOrder": 65,
          "success": true
        }
      },
      "execution_count": 65,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "The vector is: [Red, Green, Blue, Yellow]\r\n"
          },
          "metadata": {},
          "execution_count": 65
        }
      ]
    },
    {
      "id": "2d8a8151-6b4e-48d3-a479-a7290fd1d275",
      "cell_type": "code",
      "source": "Vector<String> nameList = new Vector<String>();\r\n// Method: add(item) / add(index, item)\r\n// What:   adds an item at the end, or inserts it at the given index (items after it shift right)\r\n// Use:    to put new values into the list\r\nnameList.add(\"Prachi\");\r\nSystem.out.println(\"The list is: \" + nameList);",
